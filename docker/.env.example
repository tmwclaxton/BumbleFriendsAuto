# Copy to /opt/lgspipeline/.env on the server (never commit real secrets).

SERIAL=29081FDH200GZ8
PIXEL_SERIAL=29081FDH200GZ8
PHONE_UNLOCK_PIN=changeme

DASHBOARD_BASIC_USER=admin
DASHBOARD_BASIC_PASSWORD=changeme

PORT=8765
TZ=Europe/London
ENABLE_CRON=1
DB_PATH=/app/data/friends.db

# NanoGPT vision for inbox “Guess from photos” ethnicity tags.
NANOGPT_API_KEY=
NANOGPT_VISION_MODEL=google/gemini-2.5-flash
# GPT Sol for automatic reply drafts (draft-only — never sends on the phone).
NANOGPT_CHAT_MODEL=openai/gpt-5.6-sol

# Obsidian MCP on this host (publish mcp on 127.0.0.1:18080).
OBSIDIAN_MCP_URL=http://127.0.0.1:18080/mcp
OBSIDIAN_MCP_TOKEN=
AUTO_DRAFT_ENABLED=1
